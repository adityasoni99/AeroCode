# Aero-Code ProofLoop Environment Configuration

# Nebius Token Factory Configuration (Required for Live LLM execution)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# NVIDIA Nemotron Models
PRIMARY_MODEL=nvidia/Nemotron-3.5-Lightning
ESCALATION_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily AI Contextual Research (Required for Live Web & Doc Search Bonus Track)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# GitHub Token for Autonomous Pull Request Creation (Optional)
GITHUB_TOKEN=ghp_your_github_token_here

# ProofLoop Execution Mode: "demo" (reproducible offline fixtures) or "live"
MODE=demo
TIMEOUT_SECONDS=45
MAX_RETRIES=3

# Live verification uses a prebuilt local image containing pytest and target dependencies.
# These names match the Pydantic Settings fields (no AERO_CODE prefix).
SANDBOX_IMAGE=aero-code-sandbox:local
# Only enable for trusted code: unavailable Docker may otherwise execute on the host.
SANDBOX_ALLOW_SUBPROCESS_FALLBACK=false
